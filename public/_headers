# Cloudflare Pages custom headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# Security headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Content-hashed, immutable assets — cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Videos and posters change rarely — cache for a week.
/assets/videos/*
  Cache-Control: public, max-age=604800

# The service worker must always be revalidated so updates ship promptly.
/service-worker.js
  Cache-Control: no-cache
