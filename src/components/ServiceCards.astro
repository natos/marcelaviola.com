---
/**
 * Grid of service cards linking to each service page. Used on the home page
 * (all services) and under each service page (related services).
 */
import { Picture } from "astro:assets";
import { servicePath, type Service } from "../data/services";

interface Props {
  services: Service[];
  /** Heading level for the card titles, to keep the outline correct. */
  headingLevel?: "h3" | "h4";
}

const { services, headingLevel: Heading = "h3" } = Astro.props;
---

<ul class="service-cards">
  {
    services.map((service) => (
      <li class="service-card">
        <a class="service-card-link" href={servicePath(service)}>
          <Picture
            src={service.data.image}
            formats={["avif", "webp"]}
            fallbackFormat="jpeg"
            widths={[400, 800]}
            sizes="(min-width: 1024px) 20vw, (min-width: 640px) 45vw, 100vw"
            alt=""
            class="service-card-image"
            loading="lazy"
            decoding="async"
          />
          <Heading class="service-card-title">{service.data.name}</Heading>
          <p class="service-card-text">{service.data.summary}</p>
          <span class="service-card-more" aria-hidden="true">
            Learn more &rarr;
          </span>
        </a>
      </li>
    ))
  }
</ul>
