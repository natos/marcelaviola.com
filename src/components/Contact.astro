---
/**
 * Contact section. Replaces the Hugo contact.html partial.
 */
import SectionImage from "./SectionImage.astro";
import Social from "./Social.astro";
import contactImg from "../images/contact/contact.jpg";

const onboardingForm =
  "https://forms.zohopublic.com/strongwithmarce/form/CounselingIntakeForm/formperma/8USVH11UWDlS7BZzV5T-NTyTmDyxdC4QonTF-DyAqRA";
---

<section id="contact">
  <header>
    <h1>Contact</h1>
  </header>
  <SectionImage src={contactImg} alt="Marcela Viola" />
  <article class="content">
    <p>
      You've made it this far! you know what you want and this is your time to
      work on yourself.
    </p>

    <p>I offer different options to accommodate everybody:</p>

    <ul>
      <li>1 on 1 in-person training</li>
      <li>Small group class</li>
      <li>Online live coaching</li>
      <li>Online 4-8 weeks program with weekly check-ins.</li>
    </ul>

    <p>
      <a href={onboardingForm} target="_blank" rel="noopener noreferrer">
        Start with the training onboarding form.
      </a>
    </p>

    <p>
      <a href="mailto:strongwithmarce@gmail.com"
        >You can reach out to me by email</a
      >, or on my social media:
    </p>

    <Social />
  </article>
</section>
