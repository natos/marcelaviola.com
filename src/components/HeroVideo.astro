---
/**
 * Hero banner — a self-contained 100svh section with a muted, looping
 * background video. A <picture> behind the videos paints the matching poster
 * instantly (and is all no-JS, reduced-motion and data-saver visitors ever
 * see); the browser downloads only the poster for the current screen. CSS
 * media queries show the portrait or landscape video element. Video sources are attached by the script
 * below, after the page has loaded, and only for the element that is actually
 * displayed, so a phone never downloads the landscape clip.
 */
import { hero } from "../data/hero";
const { copy } = hero;
const { landscape, portrait } = hero.video;
const av1Type = 'video/mp4; codecs="av01.0.05M.08"';
---

<section class="hero" aria-label="Introduction" data-hero>
  <picture class="hero-poster">
    <source media="(width >= 760px)" srcset={landscape.poster} />
    <img src={portrait.poster} alt="" fetchpriority="high" decoding="async" />
  </picture>
  <video
    class="hero-video desktop"
    muted
    playsinline
    loop
    preload="none"
    aria-hidden="true"
  >
    <source data-src={landscape.av1} type={av1Type} />
    <source data-src={landscape.h264} type="video/mp4" />
  </video>
  <video
    class="hero-video mobile"
    muted
    playsinline
    loop
    preload="none"
    aria-hidden="true"
  >
    <source data-src={portrait.av1} type={av1Type} />
    <source data-src={portrait.h264} type="video/mp4" />
  </video>

  <div class="hero-overlay">
    <div class="hero-content">
      <p class="hero-kicker">{copy.kicker}</p>
      <h1 class="hero-title">
        {copy.title.map((line) => <span class="hero-title-line">{line}</span>)}
      </h1>
      <p class="hero-lede">{copy.lede}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={copy.primaryCta.url}>{copy.primaryCta.label}</a>
        <a class="btn btn-ghost" href={copy.secondaryCta.url}>{copy.secondaryCta.label}</a>
      </div>
    </div>
    <a class="hero-scroll" href="#about" aria-label="Scroll to content">
      <span class="hero-scroll-label">Scroll</span>
      <span class="hero-scroll-chevron" aria-hidden="true"></span>
    </a>
  </div>
</section>

<script is:inline>
  (() => {
    const videos = Array.from(document.querySelectorAll("video.hero-video"));
    const hero = document.querySelector(".hero");
    if (!videos.length || !hero) return;

    // Poster only: reduced motion, or the visitor asked to save data / is on
    // a very slow connection.
    const connection = navigator.connection;
    const saveData =
      connection && (connection.saveData || /(^|-)2g$/.test(connection.effectiveType || ""));
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || saveData) return;

    let heroOnScreen = true;
    const isDisplayed = (video) => getComputedStyle(video).display !== "none";

    // Attach the sources on first use; the browser then picks AV1 or H.264.
    const ensureLoaded = (video) => {
      if (video.dataset.loaded) return;
      video.dataset.loaded = "true";
      video.querySelectorAll("source[data-src]").forEach((source) => {
        source.src = source.dataset.src;
      });
      video.load();
    };

    // Play only the displayed video, and only while the hero is on screen.
    const sync = () => {
      videos.forEach((video) => {
        if (heroOnScreen && isDisplayed(video)) {
          ensureLoaded(video);
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    };

    const start = () => {
      sync();
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(
          (entries) => {
            heroOnScreen = entries[0].isIntersecting;
            sync();
          },
          { threshold: 0 },
        ).observe(hero);
      }
      // Rotating a tablet can swap which element is displayed.
      window.matchMedia("(width >= 760px)").addEventListener("change", sync);
    };

    // Wait until the page (and the poster, its largest image) has loaded so
    // the video never competes with first paint.
    const schedule = () =>
      "requestIdleCallback" in window
        ? requestIdleCallback(start, { timeout: 1500 })
        : setTimeout(start, 200);
    if (document.readyState === "complete") schedule();
    else window.addEventListener("load", schedule, { once: true });
  })();
</script>
