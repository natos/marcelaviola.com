---
/**
 * Full-bleed background hero videos. Replaces the Hugo hero-video.html partial.
 * No UA sniffing / JS: CSS media queries pick portrait vs landscape source.
 * autoplay + muted + playsinline + loop keeps iOS Safari autoplay working.
 * Posters give an instant first paint; a small script honours
 * prefers-reduced-motion by pausing on the poster frame.
 */
import { hero } from "../data/hero";
const { copy } = hero;
---

<video
  class="hero-video desktop"
  autoplay
  muted
  playsinline
  loop
  preload="auto"
  poster={hero.video.landscapePoster}
  aria-hidden="true"
>
  <source src={hero.video.landscape} type="video/mp4" />
</video>
<video
  class="hero-video mobile"
  autoplay
  muted
  playsinline
  loop
  preload="auto"
  poster={hero.video.portraitPoster}
  aria-hidden="true"
>
  <source src={hero.video.portrait} type="video/mp4" />
</video>

<div class="hero-overlay" data-hero>
  <div class="hero-content">
    <p class="hero-kicker">{copy.kicker}</p>
    <h2 class="hero-title">
      {copy.title.map((line) => <span class="hero-title-line">{line}</span>)}
    </h2>
    <p class="hero-lede">{copy.lede}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={copy.primaryCta.url}>{copy.primaryCta.label}</a>
      <a class="btn btn-ghost" href={copy.secondaryCta.url}>{copy.secondaryCta.label}</a>
    </div>
  </div>
  <a class="hero-scroll" href="#about" aria-label="Scroll to content">
    <span class="hero-scroll-label">Scroll</span>
    <span class="hero-scroll-chevron" aria-hidden="true"></span>
  </a>
</div>

<script is:inline>
  // Respect users who prefer reduced motion: don't autoplay the hero videos,
  // leave the poster frame showing instead.
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll("video.hero-video").forEach((video) => {
      video.removeAttribute("autoplay");
      video.pause();
    });
  }
</script>

