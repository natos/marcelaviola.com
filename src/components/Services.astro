---
/**
 * Services section on the home page: a short introduction and a card per
 * service page. The detailed copy for each service lives on its own page
 * (src/content/services/*.md).
 */
import SectionHeading from "./SectionHeading.astro";
import ServiceCards from "./ServiceCards.astro";
import { getServices } from "../data/services";

interface Props {
  index?: number;
}

const { index } = Astro.props;
const services = await getServices();
---

<section id="services" class="services-section">
  <SectionHeading
    index={index}
    eyebrow="Services"
    title="Ways we can work together"
  />
  <div class="services-intro">
    <p>
      Whether you want to make better food choices, finally feel confident in
      the gym, or move without that everlasting back or neck pain — whatever the
      starting point is, you can feel and perform better.
    </p>
    <p>
      Every program starts with understanding you: what is important to you and
      what your goals are.
    </p>
  </div>
  <ServiceCards services={services} />
</section>
