---
/**
 * SEO / document head. Replaces the Hugo meta.html partial.
 * Emits charset, viewport, description/keywords, Open Graph, Twitter card,
 * canonical, and favicon. Per-page title/description override the defaults.
 */
import { site, person, contact, type Breadcrumb } from "../data/site";
import { social } from "../data/social";
import { hero } from "../data/hero";
import { credentials } from "../data/credentials";
import type { Faq } from "../data/faq";
import { getServices, servicePath } from "../data/services";

interface Props {
  title?: string;
  description?: string;
  /** Path or absolute URL for the social share image. */
  image?: string;
  /** Alt text for the share image; defaults to the site card's. */
  imageAlt?: string;
  /** Questions shown on the page, emitted as schema.org FAQPage markup. */
  faqs?: Faq[];
  /** Trail from the home page, emitted as schema.org BreadcrumbList. */
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  imageAlt = site.ogImageAlt,
  faqs = [],
  breadcrumbs = [],
} = Astro.props;

const services = await getServices();

const canonical = new URL(Astro.url.pathname, site.url).href;
const absoluteImage = new URL(image, site.url).href;
const pageTitle = title ? `${title} — ${site.name}` : site.homeTitle;

const id = (fragment: string) => `${site.url}/#${fragment}`;

// Where coaching is offered: in person in Singapore, online anywhere.
const areaServed = [
  { "@type": "Country", name: contact.areaServed },
  { "@type": "Place", name: "Worldwide (online coaching)" },
];

// Structured data for search engines and AI assistants. No numeric ratings
// are asserted: the testimonials carry no scores, and Google ignores (and
// may penalise) review markup a business publishes about itself.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": id("website"),
      url: `${site.url}/`,
      name: site.name,
      description: site.description,
      inLanguage: site.languageCode,
      publisher: { "@id": id("business") },
    },
    {
      "@type": "Person",
      "@id": id("person"),
      name: person.name,
      jobTitle: person.jobTitle,
      description: person.description,
      url: `${site.url}/`,
      image: new URL(person.image, site.url).href,
      email: `mailto:${contact.email}`,
      knowsAbout: person.knowsAbout,
      hasCredential: credentials.map((credential) => ({
        "@type": "EducationalOccupationalCredential",
        name: credential.title,
        credentialCategory: "certification",
        recognizedBy: { "@type": "Organization", name: credential.issuer },
        dateCreated: String(credential.year),
      })),
      worksFor: { "@id": id("business") },
      sameAs: social.map((s) => s.url),
    },
    {
      "@type": "ProfessionalService",
      "@id": id("business"),
      name: `${person.name} Coaching`,
      description: site.description,
      url: `${site.url}/`,
      image: absoluteImage,
      logo: new URL("/icon-512.png", site.url).href,
      email: contact.email,
      founder: { "@id": id("person") },
      areaServed,
      knowsAbout: person.knowsAbout,
      sameAs: social.map((s) => s.url),
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Coaching services",
        itemListElement: services.map((service) => ({
          "@type": "Offer",
          itemOffered: { "@id": `${site.url}${servicePath(service)}#service` },
        })),
      },
    },
    ...services.map((service) => {
      // Channels come from the formats listed on the service page.
      const inPerson = service.data.formats.some((f) => f.includes(contact.areaServed));
      const online = service.data.formats.some((f) => /online/i.test(f));
      return {
        "@type": "Service",
        "@id": `${site.url}${servicePath(service)}#service`,
        url: `${site.url}${servicePath(service)}`,
        name: service.data.name,
        description: service.data.summary,
        serviceType: service.data.name,
        areaServed: [
          ...(inPerson ? [{ "@type": "Country", name: contact.areaServed }] : []),
          ...(online ? [{ "@type": "Place", name: "Worldwide (online coaching)" }] : []),
        ],
        availableChannel: [
          ...(inPerson ? [{ "@type": "ServiceChannel", name: `In person (${contact.areaServed})` }] : []),
          ...(online ? [{ "@type": "ServiceChannel", name: "Online" }] : []),
        ],
        provider: { "@id": id("business") },
      };
    }),
    ...(breadcrumbs.length
      ? [
          {
            "@type": "BreadcrumbList",
            "@id": `${canonical}#breadcrumbs`,
            itemListElement: [{ name: "Home", path: "/" }, ...breadcrumbs].map(
              (crumb, index) => ({
                "@type": "ListItem",
                position: index + 1,
                name: crumb.name,
                item: `${site.url}${crumb.path}`,
              }),
            ),
          },
        ]
      : []),
    ...(faqs.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${canonical}#faq`,
            mainEntity: faqs.map((faq) => ({
              "@type": "Question",
              name: faq.question,
              acceptedAnswer: { "@type": "Answer", text: faq.answer },
            })),
          },
        ]
      : []),
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#000000" />
<title>{pageTitle}</title>
<meta name="author" content={site.author} />
<meta name="description" content={description} />
<meta name="keywords" content={site.keywords} />
<link rel="canonical" href={canonical} />

<!-- Preload the device-appropriate hero poster (the LCP image). -->
<link
  rel="preload"
  as="image"
  href={hero.video.landscape.poster}
  media="(min-width: 760px)"
/>
<link
  rel="preload"
  as="image"
  href={hero.video.portrait.poster}
  media="(max-width: 759px)"
/>

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={site.name} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="icon" href="/assets/images/favicon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(structuredData)}
/>
