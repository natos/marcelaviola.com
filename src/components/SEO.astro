---
/**
 * SEO / document head. Replaces the Hugo meta.html partial.
 * Emits charset, viewport, description/keywords, Open Graph, Twitter card,
 * canonical, and favicon. Per-page title/description override the defaults.
 */
import { site, person, offerings } from "../data/site";
import { social } from "../data/social";
import { hero } from "../data/hero";

interface Props {
  title?: string;
  description?: string;
  /** Path or absolute URL for the social share image. */
  image?: string;
}

const {
  title,
  description = site.description,
  image = site.ogImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const absoluteImage = new URL(image, site.url).href;
const pageTitle = title ? `${title} — ${site.name}` : site.homeTitle;

// Structured data: the site (WebSite) and its subject (Person). No numeric
// ratings are asserted — the testimonials carry no scores, so we avoid
// fabricating a schema.org aggregateRating.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
      description: site.description,
      inLanguage: site.languageCode,
    },
    {
      "@type": "Person",
      "@id": `${site.url}/#person`,
      name: person.name,
      jobTitle: person.jobTitle,
      url: `${site.url}/`,
      image: new URL(person.image, site.url).href,
      description: person.description,
      sameAs: social.map((s) => s.url),
    },
    ...offerings.map((offering, index) => ({
      "@type": "Service",
      "@id": `${site.url}/#service-${index + 1}`,
      name: offering.name,
      description: offering.description,
      serviceType: offering.name,
      areaServed: "Singapore",
      provider: { "@id": `${site.url}/#person` },
    })),
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#000000" />
<title>{pageTitle}</title>
<meta name="author" content={site.author} />
<meta name="description" content={description} />
<meta name="keywords" content={site.keywords} />
<link rel="canonical" href={canonical} />

<!-- Preload the device-appropriate hero poster (the LCP image). -->
<link
  rel="preload"
  as="image"
  href={hero.video.landscapePoster}
  media="(min-width: 760px)"
/>
<link
  rel="preload"
  as="image"
  href={hero.video.portraitPoster}
  media="(max-width: 759px)"
/>

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={site.name} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

<link rel="icon" href="/assets/images/favicon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(structuredData)}
/>
