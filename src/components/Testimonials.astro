---
/**
 * Testimonials section. Replaces the Hugo testimonials.html partial.
 * Content is driven by src/data/testimonials.ts.
 */
import SectionImage from "./SectionImage.astro";
import { testimonials } from "../data/testimonials";
import testimonialImg from "../images/v/240221 R6ii - R6II6409.jpg";
---

<section id="testimonials">
  <header>
    <h1>Testimonials</h1>
  </header>
  <SectionImage src={testimonialImg} alt="Marcela Viola" />
  <article class="content">
    {
      testimonials.map((testimonial) => (
        <figure class="testimonial">
          <blockquote>
            <p>{testimonial.quote}</p>
          </blockquote>
          <figcaption>{testimonial.name}</figcaption>
        </figure>
      ))
    }
  </article>
</section>
