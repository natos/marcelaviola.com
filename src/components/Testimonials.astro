---
/**
 * Testimonials section. Replaces the Hugo testimonials.html partial.
 * Content is driven by src/data/testimonials.ts.
 */
import SectionHeading from "./SectionHeading.astro";
import { testimonials, highlights } from "../data/testimonials";

interface Props {
  index?: number;
}

const { index } = Astro.props;
---

<section id="testimonials" class="testimonials-section">
  <SectionHeading index={index} eyebrow="Testimonials" title="What clients say" />
  <ul class="testimonial-highlights" aria-label="Highlights from client reviews">
    {
      highlights.map((highlight) => (
        <li class="highlight">
          <p class="highlight-phrase">{highlight.phrase}</p>
          <p class="highlight-name">{highlight.name}</p>
        </li>
      ))
    }
  </ul>
  <ul class="testimonial-grid">
    {
      testimonials.map((testimonial) => (
        <li class="testimonial-card">
          <blockquote>{testimonial.quote}</blockquote>
          <p class="testimonial-author">{testimonial.name}</p>
        </li>
      ))
    }
  </ul>
</section>
