---
/**
 * Credentials section. Replaces the Hugo credentials.html partial.
 * Content is driven by src/data/credentials.ts.
 */
import SectionImage from "./SectionImage.astro";
import SectionHeading from "./SectionHeading.astro";
import { credentials } from "../data/credentials";
import credentialsImg from "../images/credentials/credentials.jpg";

interface Props {
  index?: number;
}

const { index } = Astro.props;
---

<section id="credentials" class="reverse">
  <SectionHeading index={index} eyebrow="Credentials" title="Qualified, and always growing" />
  <SectionImage src={credentialsImg} alt="Marcela Viola coaching a client" />
  <article class="content">
    <ul class="credential-list">
      {
        credentials.map((credential) => (
          <li class="credential">
            <span class="credential-issuer">{credential.issuer}</span>
            <span class="credential-year">{credential.year}</span>
            <span class="credential-detail">{credential.title}</span>
          </li>
        ))
      }
    </ul>
  </article>
</section>
