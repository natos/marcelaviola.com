---
/**
 * Credentials section. Replaces the Hugo credentials.html partial.
 * Content is driven by src/data/credentials.ts.
 */
import SectionImage from "./SectionImage.astro";
import SectionHeading from "./SectionHeading.astro";
import { credentials } from "../data/credentials";
import credentialsImg from "../images/credentials/credentials.jpg";
---

<section id="credentials" class="reverse">
  <SectionHeading index={2} eyebrow="Credentials" title="Qualified, and always growing" />
  <SectionImage src={credentialsImg} alt="Marcela Viola coaching a client" />
  <article class="content">
    {
      credentials.map((credential) => (
        <>
          <h2>{credential.issuer}</h2>
          <p>
            {credential.title} - {credential.year}
          </p>
        </>
      ))
    }
  </article>
</section>
