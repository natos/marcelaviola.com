---
/**
 * Numbered section heading — a small eyebrow (index + label) above an h2 title.
 * Gives every section a consistent, editorial structure.
 */
interface Props {
  /** Section number on the home page; omit on pages without numbering. */
  index?: number;
  eyebrow: string;
  title: string;
  /** "h1" when the section heading is the page title. */
  level?: "h1" | "h2";
}

const { index, eyebrow, title, level: Heading = "h2" } = Astro.props;
const number = index === undefined ? undefined : String(index).padStart(2, "0");
---

<header class="section-head">
  <p class="section-eyebrow">
    {number && <span class="section-number">{number}</span>}
    <span class="section-eyebrow-label">{eyebrow}</span>
  </p>
  <Heading class="section-title">{title}</Heading>
</header>
