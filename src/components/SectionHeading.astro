---
/**
 * Numbered section heading — a small eyebrow (index + label) above an h2 title.
 * Gives every section a consistent, editorial structure.
 */
interface Props {
  index: number;
  eyebrow: string;
  title: string;
}

const { index, eyebrow, title } = Astro.props;
const number = String(index).padStart(2, "0");
---

<header class="section-head">
  <p class="section-eyebrow">
    <span class="section-number">{number}</span>
    <span class="section-eyebrow-label">{eyebrow}</span>
  </p>
  <h2 class="section-title">{title}</h2>
</header>
