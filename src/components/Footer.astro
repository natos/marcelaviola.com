---
/**
 * Site footer. Replaces the Hugo foot.html partial.
 */
import { credits } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="global">
  <div class="credits">
    <p>
      📸 Photography by {
        credits.photographers.map((p, i) => (
          <>
            <a href={p.url} target="_blank" rel="noopener noreferrer">
              {p.handle}
            </a>
            {i < credits.photographers.length - 1 ? " and " : ""}
          </>
        ))
      }
    </p>
  </div>
  <p>
    Crafted with <em>extra</em> <span class="heart">❤</span> by
    <a href={credits.author.url} target="_blank" rel="noopener noreferrer"
      >{credits.author.name}</a
    ><br />
    &copy;{year} all rights reserved
  </p>
</footer>
