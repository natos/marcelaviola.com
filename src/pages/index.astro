---
// Home page — the story-led overview. Each service has its own page
// (src/pages/[service].astro); the Services section links to them.
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroVideo from "../components/HeroVideo.astro";
import About from "../components/About.astro";
import Credentials from "../components/Credentials.astro";
import Services from "../components/Services.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Testimonials from "../components/Testimonials.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import { faqs } from "../data/faq";
---

<BaseLayout faqs={faqs}>
  <HeroVideo />
  <About index={1} />
  <Credentials index={2} />
  <Services index={3} />
  <HowItWorks index={4} />
  <Testimonials index={5} />
  <Faq index={6} />
  <Contact index={7} />
</BaseLayout>
